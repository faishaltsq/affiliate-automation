# ── Affiliate Automation V2 — configuration example ─────────────────────────
# Copy to .env and fill in. NEVER commit .env.
# Every live side effect is OFF by default. Leave it that way until an
# operator has reviewed docs/v2/07-quality-review.md and approved cutover.

# ── LLM (OpenAI-compatible gateway) ────────────────────────────────────────
LLM_BASE_URL=https://api.trustisgold.web.id/v1
LLM_MODEL=tig/laguna-s-2.1
LLM_FALLBACK_MODELS=tig/laguna-xs-2.1,tig/step-3.7-flash,tig/step-5-unrestricted
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── V2 FEATURE FLAGS — all default OFF ─────────────────────────────────────
# AUTOPUBLISH_ENABLED: allow the scheduler to enqueue for live publishing.
AUTOPUBLISH_ENABLED=false
# AFFILIATE_AUTO_ENABLED: allow affiliate links to be attached.
AFFILIATE_AUTO_ENABLED=false
# DRY_RUN: when true, every adapter is a no-op. Live adapters require this to
# be false AND AUTOPUBLISH_ENABLED=true.
DRY_RUN=true
# V2_SCHEDULER_ENABLED: run the V2 scheduler loop.
V2_SCHEDULER_ENABLED=false
# V2_TELEGRAM_COMMANDS_ENABLED: activate the V2 Telegram command set.
V2_TELEGRAM_COMMANDS_ENABLED=false
# SHADOW_MODE: generate and queue without publishing.
SHADOW_MODE=true

# ── V2 SCHEDULER ───────────────────────────────────────────────────────────
V2_MAIN_POSTS_PER_DAY=1
V2_MAX_EXTRA_POSTS_PER_WEEK=3
V2_QUIET_START_HOUR=23
V2_QUIET_END_HOUR=6
V2_POLL_INTERVAL_SECONDS=300
V2_SCHEDULER_PAUSED=false

# ── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated NUMERIC user IDs allowed to run mutation commands.
# Empty = deny every mutation (fail closed).
TELEGRAM_OPERATOR_IDS=
TG_AFFILIATE_CHAT_ID=-1003757350269
TG_THREADS_THREAD_ID=9
TG_TIKTOK_THREAD_ID=83
TG_CLIPPER_THREAD_ID=246

# ── Threads (Meta Graph) ───────────────────────────────────────────────────
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_PUBLISH_TIMEOUT_SECONDS=30

# ── TikTok Shop Affiliate ──────────────────────────────────────────────────
# NOTE: a hand-built af_id URL is NOT proof of commission attribution.
# Products must be imported from the official affiliate dashboard.
TIKTOK_AFFILIATE_ID=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Image generation & storage (optional) ──────────────────────────────────
REPLICATE_API_TOKEN=
REPLICATE_MODEL=ac732df83cea7fff18b8472768c88ad041fa750ff7682a21affe81863cbe77e4
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Legacy / preserved integrations ────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=affiliate_trend_bot
SHOPEE_CLIENT_ID=
SHOPEE_CLIENT_SECRET=
SHOPEE_AFFILIATE_CODE=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=
DISCORD_TOKEN=
MOTIONKLIP_GUILD_ID=
MOTIONKLIP_CHANNELS=
AHREFS_TOKEN=
GRAMMARLY_TOKEN=
SENTRY_DSN=
